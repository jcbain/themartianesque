---
import { getCollection } from 'astro:content';
import BaseHead from '../components/ui/BaseHead.astro';
import MacClassicResponsive from '../components/react/MacClassicResponsive.jsx';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { mapPostEntry } from '../lib/mapPosts';

const postsCollection = (await getCollection('posts')).sort((a, b) => b.data.id - a.data.id);
const posts = postsCollection.map(mapPostEntry);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				margin: 0;
				overflow: hidden;
			}
			main {
				width: 100%;
				max-width: 100%;
				padding: 0;
			}
		</style>
	</head>
	<body>
		<main>
			<MacClassicResponsive posts={posts} client:load />
		</main>
	</body>
</html>
