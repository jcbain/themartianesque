---
import BaseHead from '../../components/ui/BaseHead.astro';
import MacClassicResponsive from '../../components/react/MacClassicResponsive.jsx';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getAppPostStaticPaths, getAppPosts } from '../../lib/posts';

export function getStaticPaths() {
	return getAppPostStaticPaths();
}

const posts = await getAppPosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				margin: 0;
				overflow: hidden;
			}
			main {
				width: 100%;
				max-width: 100%;
				padding: 0;
			}
		</style>
	</head>
	<body>
		<main>
			<MacClassicResponsive posts={posts} client:load />
		</main>
	</body>
</html>
