---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/ui/BaseHead.astro';
import MacClassicResponsive from '../../components/react/MacClassicResponsive.jsx';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

export function getStaticPaths() {
	return getCollection('posts').then((entries) =>
		entries.map((entry) => ({
			params: { id: String(entry.data.id) },
		})),
	);
}

const postsCollection = (await getCollection('posts')).sort((a, b) => b.data.id - a.data.id);
const posts = postsCollection.map((entry) => ({
	id: entry.data.id,
	title: entry.data.title,
	date: entry.data.pubDate.toLocaleDateString('en-US', {
		weekday: 'long',
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	}),
	wordCount: entry.body.trim().split(" ").length,
	content: entry.body.trim(),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				margin: 0;
				overflow: hidden;
			}
			main {
				width: 100%;
				max-width: 100%;
				padding: 0;
			}
		</style>
	</head>
	<body>
		<main>
			<MacClassicResponsive posts={posts} client:load />
		</main>
	</body>
</html>
